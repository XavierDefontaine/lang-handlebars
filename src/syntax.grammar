@top Template { (directive | Text)* }

directive {
  Insert |
  BlockDirective |
  Escape |
  RawBlock |
  BlockComment |
  OnelineComment
}

// Block with opening operator and content
BlockDirective { BlockOpen (BlockInverse | directive | Text)* BlockClose }

BlockOpen { 
  "{{" BlockOperator BlockHelper Identifier (Identifier)* "}}" |
  "{{" BlockOperator Identifier "}}" 
}

BlockInverse { 
  "{{" BlockHelperInverse "}}"
}

BlockClose { 
  "{{" "/" (BlockHelper | Identifier) "}}"
}

BlockOperator { "#" | "^" | "*" }

Insert { "{{" (space* (Identifier | Number | Bool | String | Equa | Subexp | "|" | "~"))*  space* "}}" }

Escape { "{{{" Any "}}}" | "{{{{{" "{"* Any "}"* "}}}}}"}

RawOpen { "{{{{" Any "}}}}" }
RawClose { "{{{{/" Any "}}}}" }

RawBlock { RawOpen (directive | Text)* RawClose }

@local tokens {
  blockCommentEnd { "--}}" }
  blockCommentNewline { "\n" }
  @else blockCommentContent
}

@skip {} {
  BlockComment { "{{!--" (blockCommentContent | blockCommentNewline)* blockCommentEnd }
}

@skip { spaces | newline }

@local tokens {
  oneLineCommentEnd { "}}" }
  @else oneLineCommentContent
}

@skip {} {
  OnelineComment { "{{!" oneLineCommentContent* oneLineCommentEnd }
}

@context trackNewline from "./tokens.js"

Bool { @specialize<Identifier, "true" | "false"> }
Equa { Identifier "=" (Identifier | Number | Bool | String) }
Subexp { "(" (space* (Identifier | Number | Bool | String | Equa | Subexp | "|"))*  space* ")" }

@tokens {
  spaces[@export] { $[\u0009 \u000b\u00a0\u1680\u2000-\u200a\u202f\u205f\u3000\ufeff]+ }
  newline[@export] { $[\r\n\u2028\u2029] }
  identifierChar { @asciiLetter | $[_$\u{a1}-\u{10ffff}] | "../" | "@" }
  word { identifierChar (identifierChar | @digit | "." | "#" | "-" | "_" | " ")* }
  
  Identifier { word }
  
  // Known block helper keywords
  BlockHelper { "each" | "if" | "unless" | "with" }
  BlockHelperInverse { "else" }
  
  Text { ![{] Text? | "{" (@eof | ![{] Text?) }
  hex { @digit | $[a-fA-F] }
  Any { (![{|}])+ }
  String { ("'" (![\\'] | "\\" _)* "'"?) | ("\"" (![\\"] | "\\" _)* "\""?) }
  Number {
    (@digit ("_" | @digit)* ("." ("_" | @digit)*)? | "." @digit ("_" | @digit)*)
      (("e" | "E") ("+" | "-")? ("_" | @digit)+)? |
    @digit ("_" | @digit)* "n" |
    "0x" (hex | "_")+ "n"? |
    "0b" $[01_]+ "n"? |
    "0o" $[0-7_]+ "n"?
  }
  space { @whitespace+ }
  
  @precedence { BlockHelperInverse, BlockHelper, Identifier }
  @precedence { space, Identifier }
  @precedence { spaces, newline, Identifier }
  @precedence { spaces, newline, Text }
  @precedence { Any, spaces, newline }
  @precedence { spaces, newline, space }
  
  "{{"
  "}}"
  "."
  "~"
}

@external propSource Highlight from "./highlight.js"